# ============================================================
# MARAM Payroll Platform — environment configuration
# Copy to `.env` and adjust. NEVER commit the real .env file.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=payroll
POSTGRES_USER=payroll
POSTGRES_PASSWORD=payroll_dev_password
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=payroll-dev

# ---- Backend (Spring Boot) ----
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# Min 32 chars — used to sign JWT access/refresh tokens
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---- Frontend ----
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api
